# A media: E(x)
f_med <- function(x)
{
return(x*fdens(x))
}
Ex <- integrate(f_med,-1,1)
Ex
# A P(-0.5 <= x <=1)
# Coa fórmula:
#P(-0.5 <= x <=1) =  P(X <= 1)- P(X < -0.5)
Fdist(1)-Fdist(-0.5)
return((x-Ex)^2-f(x))
return((x-Ex$value)^2*f(x))
names(Ex)
return((x-Ex$value)^2*f(x))
return((x-Ex$value)^2*fdens(x))
fvar <- function(x)
{

								"reference": {
									"$ref": "AAAAAAGNpzZm9X1LbJU="
								}
							}
						}
					],
					"documentation": "cu-07\nSólo se podrán levantar construcciones en celdas transitables; las celdas en las que se crea una construcción se convierten en no transitables.\n\nConstruir estación, base o torre."
				},
				{
					"_type": "UMLUseCase",
					"_id": "AAAAAAGNpt2o4w7kHgU=",
					"_parent": {
						"$ref": "AAAAAAFElm6BOFNpegQ="
					},
					"name": "Reparar",
					"documentation": "cu-08\nReparar una construcción.\n\nCuando una construcción pierda todos sus puntos se considerará destruida y no se podrá reparar.  Considerar si puede volver a ser una casilla transitable como cualquier otra, quedar como casilla en ruinas o quedar los recursos en la casilla."
				},
				{
					"_type": "UMLUseCase",
					"_id": "AAAAAAGNpt3bQg8S4ng=",
					"_parent": {
						"$ref": "AAAAAAFElm6BOFNpegQ="
					},
					"name": "Crear unidad",
					"ownedElements": [
						{
							"_type": "UMLAssociation",

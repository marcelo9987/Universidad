"}}},{"_type":"UMLAssociation","_id":"AAAAAAGNyz0uUEhmLhU=","_parent":{"$ref":"AAAAAAGNptiyTQ6K8Cw="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGNyz0uUEhnQ+g=","_parent":{"$ref":"AAAAAAGNyz0uUEhmLhU="},"reference":{"$ref":"AAAAAAGNptiyTQ6K8Cw="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGNyz0uUEhoSDY=","_parent":{"$ref":"AAAAAAGNyz0uUEhmLhU="},"reference":{"$ref":"AAAAAAGNyz0SQTeMX84="}}},{"_type":"UMLAssociation","_id":"AAAAAAGN/uwFostpQCY=","_parent":{"$ref":"AAAAAAGNptiyTQ6K8Cw="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGN/uwFostqviI=","_parent":{"$ref":"AAAAAAGN/uwFostpQCY="},"reference":{"$ref":"AAAAAAGNptiyTQ6K8Cw="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGN/uwFostr/LI=","_parent":{"$ref":"AAAAAAGN/uwFostpQCY="},"reference":{"$ref":"AAAAAAGN/uuT1Kq44r8="}}}],"documentation":"La partida contempla la participación de un mínimo de dos jugadores y un máximo de\ncuatro."},{"_type":"UMLUseCase","_id":"AAAAAAGNpt1/5g61DS8=","_parent":{"$ref":"AAAAAAFElm6BOFNpegQ="},"name":"Construir","ownedElements":[{"_type":"UMLAssociation","_id":"AAAAAAGNpzb92vrlrNI=","_parent":{"$ref":"AAAAAAGNpt1/5g61DS8="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGNpzb92vrmlUU=","_parent":{"$ref":"AAAAAAGNpzb92vrlrNI="},"reference":{"$ref":"AAAAAAGNpt1/5g61DS8="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGNpzb92vrng6M=","_parent":{"$ref":"AAAAAAGNpzb92vrlrNI="},"reference":{"$ref":"AAAAAAGNpzZm9X1LbJU="}}},{"_type":"UMLInclude","_id":"AAAAAAGNyw3GxOxR1R8=","_parent":{"$ref":"AAAAAAGNpt1/5g61DS8="},"source":{"$ref":"AAAAAAGNpt1/5g61DS8="},"target":{"$ref":"AAAAAAGNywvdvmHhoSo="}}],"documentation":"Sólo se podrán levantar construcciones en celdas transitables; las celdas en las que se crea una construcción se convierten en no transitables.\n\nConstruir estación, base o torre."},{"_type":"UMLUseCase","_id":"AAAAAAGNpt2o4w7kHgU=","_parent":{"$ref":"AAAAAAFElm6BOFNpegQ="},"name":"Reparar","ownedElements":[{"_type":"UMLInclude","_id":"AAAAAAGNyxLkmVc
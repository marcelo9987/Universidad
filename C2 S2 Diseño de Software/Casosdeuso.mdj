cV+RKAP38=","_parent":{"$ref":"AAAAAAGNptNJAA353dE="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGNpycV+RKBHk0=","_parent":{"$ref":"AAAAAAGNpycV+RKAP38="},"reference":{"$ref":"AAAAAAGNptNJAA353dE="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGNpycV+RKC2Zg=","_parent":{"$ref":"AAAAAAGNpycV+RKAP38="},"reference":{"$ref":"AAAAAAGNptXaCw5YURk="}}}],"documentation":"cualquier participante podrá, durante su turno, proponer a uno de sus adversarios una alianza entre potencias.\nEn ningún caso se podrán tender pactos entre más de dos potencias, lo que significa que una nueva alianza implica automáticamente la revocación de una anterior."},{"_type":"UMLUseCase","_id":"AAAAAAGNptNkOA4n/fg=","_parent":{"$ref":"AAAAAAFElm6BOFNpegQ="},"name":"Aceptar alianza","ownedElements":[{"_type":"UMLAssociation","_id":"AAAAAAGNpy1r8RdJRR8=","_parent":{"$ref":"AAAAAAGNptNkOA4n/fg="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGNpy1r8RdK/cE=","_parent":{"$ref":"AAAAAAGNpy1r8RdJRR8="},"reference":{"$ref":"AAAAAAGNptNkOA4n/fg="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGNpy1r8RdLTp8=","_parent":{"$ref":"AAAAAAGNpy1r8RdJRR8="},"reference":{"$ref":"AAAAAAGNptXaCw5YURk="}}}],"documentation":"podrá ser aceptada o rechazada por el receptor al iniciar su turno. Una alianza sólo se hará efectiva en el momento en que sea aceptada y, a partir de ahí, los ataques que se ordenen entre\nelementos de ambos bandos carecerán de efectividad. De la misma manera, se permitirá la\nentrada de unidades de una potencia en las construcciones de su aliado con el único propósito de restablecer la salud de dichas unidades; en este caso, la salida se producirá automáticamente y de forma inmediata.","extensionPoints":[{"_type":"UMLExtensionPoint","_id":"AAAAAAGNyxpbYA9jkpw=","_parent":{"$ref":"AAAAAAGNptNkOA4n/fg="},"name":"Alianza activa"}]},{"_type":"UMLUseCase","_id":"AAAAAAGNptXaCw5YURk=","_parent":{"$ref":"AAAAAAFElm6BOFNpegQ="},"name":"Revocar alianza","ownedElements":[{"_type":"UMLExtend","_id":"AAAAAAGNyxn94tC3jM8=","_parent":{"$ref":"AAAAAAGNptXaCw5YURk="},"source":{"$ref":"AAAAAAGNptXaCw5YURk="},"target":{"$ref":"AAAAAAGNptNkOA4n/fg="}}],"documentation":"Cancelar unilateralmente una alianza durante el turno del usuario"},{"_type":"UMLActor","_id":"AAAAAAGNptiyTQ6K8Cw=","_parent":{"$ref":"AAAAAAFElm6BOFNpegQ="},"name":"Usuario","ownedElements":[{"_type":"UMLAssociation","_id":"AAAAAAGNpyeYyBVChz4=","_parent":{"$ref":"AAAAAAGNptiyTQ6K8Cw="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGNpyeYyBVDsRI=","_parent":{"$ref":"AAAAAAGNpyeYyBVChz4="},"reference":{"$ref":"AAAAAAGNptiyTQ6K8Cw="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGNpyeYyBVEco8=","_parent":{"$ref":"AAAAAAGNpyeYyBVChz4="},"reference":{"$ref":"AAAAAAGNpwHd5REZJvg="}}},{"_type":"UMLAssociation","_id":"AAAAAAGNpyfnWRjGNOU=","_parent":{"$ref":"AAAAAAGNptiyTQ6K8Cw="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGNpyfnWRjHTvU=","_parent":{"$ref":"AAAAAAGNpyfnWRjGNOU="},"reference":{"$ref":"AAAAAAGNptiyTQ6K8Cw="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGNpyfnWRjI1XY=","_parent":{"$ref":"AAAAAAGNpyfnWRjGNOU="},"reference":{"$ref":"AAAAAAGNpuquHQ/jzLE="}}},{"_type":"UMLAssociation","_id":"AAAAAAGNpyhiGyANaQE=","_parent":{"$ref":"AAAAAAGNptiyTQ6K8Cw="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGNpyhiHCAOhKk=","_parent":{"$ref":"AAAAAAGNpyhiGyANaQE="},"reference":{"$ref":"AAAAAAGNptiyTQ6K8Cw="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGNpyhiHCAPNvg=","_parent":{"$ref":"AAAAAAGNpyhiGyANaQE="},"reference":{"$ref":"AAAAAAGNpwRpZxGuDaI="}}},{"_type":"UMLAssociation","_id":"AAAAAAGNpyioOCdvdtg=","_parent":{"$ref":"AAAAAAGNptiyTQ6K8Cw="},"end1":{"_type":"UMLAssociationEnd","_id":"AAAAAAGNpyioOCdwm2w=","_parent":{"$ref":"AAAAAAGNpyioOCdvdtg="},"reference":{"$ref":"AAAAAAGNptiyTQ6K8Cw="}},"end2":{"_type":"UMLAssociationEnd","_id":"AAAAAAGNpyioOCdxrpg=","_parent":{"$ref":"AAAAAAGNpyioOCdvdtg="},"reference":{"$ref":"AAAAAAGNpwO9hhF7Sag="}}},{"_type":"UMLAssociation"
					"documentation": "La partida contempla la participación de un mínimo de dos jugadores y un máximo de\ncuatro."
				},
				{
					"_type": "UMLUseCase",
					"_id": "AAAAAAGNpt1/5g61DS8=",
					"_parent": {
						"$ref": "AAAAAAFElm6BOFNpegQ="
					},
					"name": "Construir",
					"ownedElements": [
						{
							"_type": "UMLAssociation",
							"_id": "AAAAAAGNpzb92vrlrNI=",
							"_parent": {
								"$ref": "AAAAAAGNpt1/5g61DS8="
							},
							"end1": {
								"_type": "UMLAssociationEnd",

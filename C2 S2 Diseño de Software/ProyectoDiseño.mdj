								}
							}
						}
					],
					"documentation": "cu-05\nConstruir una nueva unidad (Robot, dron o rober)"
				},
				{
					"_type": "UMLUseCase",
					"_id": "AAAAAAGNpt4Wgw9AV5U=",
					"_parent": {
						"$ref": "AAAAAAFElm6BOFNpegQ="
					},
					"name": "Extraer recursos",
					"documentation": "cu-16\nExtraer recursos mediante una unidad / grupo tipo '_robot_' de una casilla que disponga de recursos "
				},
				{
					"_type": "UMLUseCase",
					"_id": "AAAAAAGNpt6+qQ9vEps=",
					"_parent": {
						"$ref": "AAAAAAFElm6BOFNpegQ="
					},
					"name": "Almacenar recursos",
					"documentation": "cu-17\nDepositar recursos en una estación, que a su vez los tranferirá a los recursos de la potencia propietaria para su  uso centralizado"
				},
				{
					"_type": "UMLUseCase",
					"_id": "AAAAAAGNpuJejg+oHRw=",
					"_parent": {
						"$ref": "AAAAAAFElm6BOFNpegQ="
					},
					"name": "Elegir tipo de tablero",
					"documentation": "cu-01\nAntes de iniciar la partida se deberá decidir si se hace uso del tablero por defecto, si se genera uno\nnuevo de forma pseudoaleatoria o si se carga un tablero a partir de información previamente\nalmacenada."
				},
